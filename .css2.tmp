/* ---------- Onboarding & auth ---------- */
.auth-wrap { min-height: 100vh; display: grid; place-items: center; padding: 22px 16px 40px; }
.auth-shell { width: 100%; max-width: 1060px; display: grid; gap: 22px; align-items: center; }
.auth-hero { padding: 8px 4px; }
.auth-hero h1 { margin-top: 20px; font-size: clamp(2rem, 5.2vw, 3.25rem); line-height: 1.04; letter-spacing: -.045em; }
.auth-hero h1 span { color: var(--accent-ink); }
.auth-hero p { color: var(--muted); font-size: .9rem; max-width: 52ch; margin-top: 12px; }
.auth-features { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 16px; }
.auth-list { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 9px; }
.auth-list li { display: flex; gap: 9px; font-size: .82rem; color: var(--muted); align-items: flex-start; }
.auth-list li::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); flex: 0 0 auto; margin-top: 7px; }
.auth-card { background: var(--panel); border: 1px solid var(--line); border-radius: 24px; padding: 24px; box-shadow: var(--shadow); }
.auth-card h2 { margin-bottom: 4px; }
.auth-switch { margin: 15px 0 16px; }
.auth-demo { margin-top: 14px; padding: 11px 12px; border-radius: 12px; background: var(--panel-2); border: 1px dashed var(--line); display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
.auth-demo p { font-size: .74rem; color: var(--muted); }
.auth-demo b { color: var(--text); }
.onboard-wrap { width: 100%; max-width: 880px; margin: 0 auto; padding: 22px 16px 42px; }
.onboard { background: var(--panel); border: 1px solid var(--line); border-radius: 24px; padding: 24px; box-shadow: var(--shadow); }
.onboard-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }
.form-grid { display: grid; gap: 12px; }
.form-grid .span-2 { min-width: 0; }
.check-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(135px, 1fr)); gap: 7px; }

/* ---------- Trainer ---------- */
.day-card { display: flex; flex-direction: column; gap: 10px; }
.day-card > .btn { margin-top: auto; align-self: flex-start; }
.day-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.day-weekday { font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--accent-ink); }
.day-name { font-size: 1.02rem; font-weight: 800; letter-spacing: -.02em; }
.recovery-tip { color: var(--muted); font-size: .8rem; }
.exercise-list { display: grid; gap: 8px; }
.exercise { border: 1px solid var(--line); border-radius: 12px; padding: 9px 10px; background: var(--panel-2); }
.exercise-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.exercise-name { font-weight: 750; font-size: .84rem; line-height: 1.3; }
.exercise-meta { font-size: .7rem; color: var(--muted); margin-top: 3px; }
.exercise-cues { margin-top: 5px; }
.exercise-cues summary { cursor: pointer; color: var(--accent-ink); font-weight: 650; font-size: .72rem; list-style: none; display: inline-flex; align-items: center; gap: 3px; }
.exercise-cues summary::-webkit-details-marker { display: none; }
.exercise-cues summary::before { content: "+"; font-weight: 800; }
.exercise-cues[open] summary::before { content: "−"; }
.exercise-cues[open] summary { margin-bottom: 4px; }
.exercise-cues { font-size: .74rem; color: var(--muted); line-height: 1.45; }
.overload { font-size: .7rem; color: var(--accent-ink); font-weight: 650; margin-top: 5px; }
.history-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 0; border-bottom: 1px dashed var(--line); }
.history-row:last-child { border-bottom: 0; }

/* ---------- Nutritionist ---------- */
.macro-bar + .macro-bar { margin-top: 12px; }
.macro-head { display: flex; justify-content: space-between; gap: 10px; font-size: .76rem; font-weight: 650; margin-bottom: 5px; }
.meal-title { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent-ink); font-weight: 800; margin: 12px 0 4px; }
.food-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px dashed var(--line); }
.food-row:last-child { border-bottom: 0; }
.food-name { font-weight: 700; font-size: .84rem; }
.food-macros { font-size: .7rem; color: var(--muted); margin-top: 2px; }

/* ---------- Chef ---------- */
.recipe-card { display: flex; flex-direction: column; gap: 9px; }
.recipe-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.recipe-name { font-weight: 800; font-size: .98rem; line-height: 1.25; }
.recipe-macros { display: flex; flex-wrap: wrap; gap: 5px; }
.recipe-ing { font-size: .76rem; color: var(--muted); line-height: 1.45; }
.recipe-actions { margin-top: auto; display: flex; flex-wrap: wrap; gap: 8px; }
.chip { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 999px; background: var(--panel-2); border: 1px solid var(--line); font-size: .7rem; font-weight: 650; color: var(--muted); }
.chip.good { background: var(--good-soft); color: var(--good); border-color: transparent; }
.chip.miss { background: var(--warn-soft); color: var(--warn); border-color: transparent; }
.match-box { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }

/* ---------- Health check ---------- */
.disclaimer { border: 1px solid var(--line); border-left: 4px solid var(--bad); background: var(--bad-soft); border-radius: var(--radius-sm); padding: 13px 14px; font-size: .82rem; color: var(--text); }
.disclaimer strong { color: var(--bad); }
.bmi-scale { height: 9px; border-radius: 999px; background: linear-gradient(90deg, #E9B6C6 0 18.5%, #0F172A 18.5% 50%, #881337 50% 75%, #4A0A1F 75% 100%); position: relative; margin: 14px 0 6px; }
.bmi-marker { position: absolute; top: 50%; width: 13px; height: 13px; border-radius: 50%; background: #fff; border: 2px solid #0F172A; transform: translate(-50%, -50%); box-shadow: 0 1px 4px rgba(0, 0, 0, .35); }
.scale-labels { display: flex; justify-content: space-between; font-size: .62rem; color: var(--muted); }
.water-cups { display: flex; flex-wrap: wrap; gap: 4px; margin: 10px 0; }
.cup { width: 15px; height: 21px; border-radius: 3px 3px 6px 6px; border: 1px solid var(--line); position: relative; background: var(--panel-2); }
.cup.full { background: linear-gradient(180deg, #A81C48, #881337); border-color: #881337; }
.cup.full::after { content: ""; position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.85); transform: translate(-50%, -50%); }
.note-row { padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: .82rem; }
.note-row:last-child { border-bottom: 0; }
.note-meta { font-size: .7rem; color: var(--muted); margin-top: 3px; }

/* ---------- Progress ---------- */
.chart-wrap { position: relative; height: 220px; margin-top: 6px; }
.chart-wrap canvas { width: 100%; height: 100%; display: block; }
.chart-empty { position: absolute; inset: 0; display: grid; place-items: center; color: var(--muted); font-size: .84rem; background: color-mix(in srgb, var(--panel) 70%, transparent); }
.legend { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; font-size: .72rem; color: var(--muted); }
.legend i { display: inline-block; width: 9px; height: 9px; border-radius: 3px; margin-right: 5px; }
.table-wrap { overflow-x: auto; margin-top: 4px; }
table { width: 100%; border-collapse: collapse; font-size: .8rem; }
th { text-align: left; font-size: .66rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); padding: 7px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
td { padding: 8px; border-bottom: 1px dashed var(--line); }
tr:last-child td { border-bottom: 0; }
.num { text-align: right; font-variant-numeric: tabular-nums; }

/* ---------- Modals ---------- */
.modal-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(4, 8, 18, .72); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); display: grid; place-items: center; padding: 16px; overflow-y: auto; }
.modal { width: min(700px, 100%); max-height: 92vh; overflow-y: auto; border-radius: 22px; padding: 22px; background: var(--panel); color: var(--text); box-shadow: 0 30px 80px -30px rgba(0, 0, 0, .9); border: 1px solid var(--line); }
.modal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 16px; }
.modal-head h2 { font-size: 1.2rem; }
.section-label { font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; color: var(--accent-ink); margin: 16px 0 8px; }
.setting-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 11px 0; border-bottom: 1px dashed var(--line); }
.setting-row:last-of-type { border-bottom: 0; }
.setting-row b { font-size: .85rem; }
.setting-row p { font-size: .75rem; color: var(--muted); margin-top: 2px; }
.log-head, .log-row { display: grid; grid-template-columns: minmax(0, 1fr) 78px 70px; gap: 8px; align-items: center; }
.log-head { font-size: .64rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); padding: 8px 0; }
.log-row { padding: 5px 0; }
.log-row input { min-height: 36px; padding: 7px 8px; font-size: .78rem; }
.log-ex { font-size: .82rem; font-weight: 650; line-height: 1.3; }
.log-ex small { display: block; font-size: .68rem; color: var(--muted); font-weight: 500; }
.recipe-list { display: flex; flex-wrap: wrap; gap: 6px; }
.recipe-step { display: flex; gap: 11px; align-items: flex-start; background: var(--panel-2); border: 1px solid var(--line); border-radius: 13px; padding: 14px; font-size: .9rem; }
.recipe-step .n { flex: 0 0 auto; width: 25px; height: 25px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: #fff; font-size: .75rem; font-weight: 800; }

/* ---------- Toasts ---------- */
#toast-root { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 200; display: flex; flex-direction: column; align-items: center; gap: 8px; pointer-events: none; width: max-content; max-width: calc(100vw - 32px); }
.toast { background: #0F172A; color: #fff; border: 1px solid rgba(255, 255, 255, .18); border-radius: 12px; padding: 10px 14px; font-size: .82rem; font-weight: 600; box-shadow: 0 18px 40px -18px rgba(0, 0, 0, .85); opacity: 0; transform: translateY(8px); transition: opacity .2s ease, transform .2s ease; }
.toast.show { opacity: 1; transform: translateY(0); }

/* ---------- Responsive ---------- */
@media (min-width: 640px) {
  .form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .form-grid .span-2 { grid-column: span 2; }
}
@media (min-width: 700px) {
  .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}
@media (min-width: 860px) {
  .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .auth-shell { grid-template-columns: 1.05fr .95fr; gap: 42px; }
  .auth-hero { padding: 8px 6px; }
}
@media (min-width: 1040px) {
  .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}
@media (max-width: 619px) {
  .tabs { flex-wrap: wrap; overflow-x: visible; row-gap: 4px; }
  .tab { flex: 1 1 auto; justify-content: center; padding: 8px 9px; font-size: .77rem; }
  .tab .tab-ico { font-size: .9rem; }
  .tab .tab-label { font-size: .77rem; }
  .auth-card, .onboard, .card { padding: 16px; }
  .topbar { padding: 12px 12px 6px; }
  .main { padding: 16px 12px 34px; }
  .foot { padding: 4px 12px 28px; }
  .chart-wrap { height: 190px; }
  .setting-row { flex-direction: column; align-items: flex-start; }
  .modal { padding: 17px; }
}
@media (hover: none) {
  .tab.active { transform: none; }
  .tab.active .tab-ico { max-width: 0; opacity: 0; }
  .tab.active .tab-label { max-width: 140px; opacity: 1; }
  .tab:hover:not(.active) .tab-ico { max-width: 2.2em; opacity: 1; }
  .tab:hover:not(.active) .tab-label { max-width: 0; opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
}
