async function seedDemoProfile() {
  if (state.db.profiles.demo) return;
  const salt = randomSalt();
  const hash = await hashPassword('demo1234', salt);
  const user = normalizeUser(createUser('demo', salt, hash));
  user.onboarded = true;
  user.profile = {
    name: 'Alex',
    age: 29,
    sex: 'male',
    height: 178,
    weight: 84.5,
    targetWeight: 78,
    startWeight: 86.2,
    activity: 'moderate',
    goal: 'lose',
    diet: 'nonveg',
    allergies: 'peanuts',
    injuries: 'Mild lower-back tightness after heavy hinges',
    equipment: ['bodyweight', 'dumbbells', 'barbell', 'gym', 'cardio'],
    daysPerWeek: 4,
    experience: 'beginner'
  };
  user.logs = sampleLogs();
  user.settings = { theme: '', trainerMode: 'gym' };
  state.db.profiles.demo = user;
  saveDB();
}

/* ---------------------------------------------------------------------------
   Coaching maths
   --------------------------------------------------------------------------- */
function totalsForEntries(entries) {
  return entries.reduce((sum, entry) => {
    sum.calories += Number(entry.calories) || 0;
    sum.protein += Number(entry.protein) || 0;
    sum.carbs += Number(entry.carbs) || 0;
    sum.fat += Number(entry.fat) || 0;
    return sum;
  }, { calories: 0, protein: 0, carbs: 0, fat: 0 });
}

function getCaloriesForDate(user, date) {
  return totalsForEntries(user.logs.food.filter(entry => entry.date === date));
}

function sortedWeights(user) {
  return [...user.logs.weights]
    .filter(entry => entry && entry.date)
    .sort((a, b) => a.date.localeCompare(b.date));
}

function currentWeight(user) {
  const weights = sortedWeights(user);
  if (weights.length) return Number(weights[weights.length - 1].kg) || 0;
  return Number(user.profile.weight) || 0;
}

function weightProgress(user) {
  const weights = sortedWeights(user);
  const start = Number(user.profile.startWeight) || (weights[0] && Number(weights[0].kg)) || currentWeight(user);
  const current = currentWeight(user) || start;
  const target = Number(user.profile.targetWeight) || null;
  const change = round(current - start, 1);
  const total = target ? Math.abs(target - start) : 0;
  const done = target && total > 0 ? Math.abs(current - start) : 0;
  const pct = target && total > 0 ? clamp((done / total) * 100, 0, 100) : 0;
  return {
    start: round(start, 1),
    current: round(current, 1),
    target,
    change,
    toGo: target ? round(Math.abs(target - current), 1) : null,
    pct: Math.round(pct)
  };
}

function workoutsLast7(user) {
  const from = dateOffset(-6);
  return user.logs.workouts.filter(workout => workout.date >= from && workout.date <= today());
}

function loggingStreak(user) {
  let streak = 0;
  for (let i = 0; i < 365; i++) {
    const date = dateOffset(-i);
    const hasLog = user.logs.food.some(entry => entry.date === date) ||
      user.logs.weights.some(entry => entry.date === date) ||
      user.logs.workouts.some(entry => entry.date === date) ||
      user.logs.sleep.some(entry => entry.date === date);
    if (hasLog) streak += 1;
    else if (i === 0) continue;
    else break;
  }
  return streak;
}

function sleepAverage(user) {
  const from = dateOffset(-13);
  const entries = user.logs.sleep.filter(entry => entry.date >= from);
  if (!entries.length) return null;
  return entries.reduce((sum, entry) => sum + Number(entry.hours || 0), 0) / entries.length;
}

function loggedDays(user, days = 7) {
  const result = [];
  for (let i = days - 1; i >= 0; i--) {
    const date = dateOffset(-i);
    const entries = user.logs.food.filter(entry => entry.date === date);
    if (entries.length) {
      result.push({ date, entries: entries.length, ...totalsForEntries(entries) });
    }
  }
  return result;
}

function bmiFor(user) {
  const height = Number(user.profile.height) || 0;
  const weight = currentWeight(user);
  if (!height || !weight) return 0;
  return weight / ((height / 100) ** 2);
}
function bmiCategory(bmi) {
  if (!bmi) return { label: 'Not enough data', cls: '' };
  if (bmi < 18.5) return { label: 'Underweight range', cls: 'warn' };
  if (bmi < 25) return { label: 'Healthy range', cls: 'good' };
  if (bmi < 30) return { label: 'Overweight range', cls: 'warn' };
  return { label: 'Obesity range', cls: 'bad' };
}
function hydrationTarget(user) {
  const weight = currentWeight(user) || Number(user.profile.weight) || 70;
  return Math.round(clamp((weight * 35) / 250, 6, 16));
}
function targetWarnings(user) {
  const warnings = [];
  const p = user.profile;
  const weight = currentWeight(user);
  const target = Number(p.targetWeight) || 0;
  if (target && weight && Math.abs(target - weight) > weight * 0.25) {
    warnings.push('Your target weight is more than 25% away from your current weight. A very large change is best planned with a doctor or registered dietitian.');
  }
  if (target && p.height) {
    const targetBmi = target / ((Number(p.height) / 100) ** 2);
    if (targetBmi < 17.5) warnings.push('Your target weight corresponds to a BMI below 17.5, which is not a safe long-term goal for most people.');
  }
  const t = targets(user);
  if (t.unsafe) warnings.push('Your calculated calorie target was raised to a conservative safety floor. Do not cut further without professional supervision.');
  if (p.age && Number(p.age) < 18) warnings.push('Trainer4U is designed for adults. Teenagers should follow guidance from a paediatrician or qualified coach.');
  return warnings;
}

function baseTargets(user) {
  const p = user.profile || {};
  const weight = currentWeight(user) || Number(p.weight) || 70;
  const height = Number(p.height) || 170;
  const age = Number(p.age) || 30;
  const sexAdjust = p.sex === 'male' ? 5 : p.sex === 'female' ? -161 : -78;
  const bmr = 10 * weight + 6.25 * height - 5 * age + sexAdjust;
  const tdee = bmr * (ACTIVITY_MULTIPLIERS[p.activity] || 1.55);
  const goalDelta = p.goal === 'lose' ? -500 : p.goal === 'gain' ? 400 : p.goal === 'build' ? 250 : 0;
  const safeMin = p.sex === 'female' ? 1200 : p.sex === 'male' ? 1500 : 1350;
  const rawCalories = tdee + goalDelta;
  const unsafe = rawCalories < safeMin;
  const calories = Math.round(clamp(rawCalories, safeMin, 5000) / 10) * 10;
  const proteinPerKg = p.goal === 'lose' || p.goal === 'build' ? 2 : p.goal === 'gain' ? 1.8 : 1.6;
  const protein = Math.round(clamp(weight * proteinPerKg, 60, 240));
  const fat = Math.round(clamp((calories * 0.27) / 9, 35, 130));
  const carbs = Math.max(50, Math.round((calories - protein * 4 - fat * 9) / 4));
  return {
    bmr: Math.round(bmr),
    tdee: Math.round(tdee),
    calories,
    protein,
    carbs,
    fat,
    safeMin,
    unsafe,
    goalDelta
  };
}

function getInsights(user) {
  const p = user.profile || {};
  const base = baseTargets(user);
  const alerts = [];
  const adjustments = { days: 0, sets: 0, calorie: 0, protein: 0 };
  const planned = clamp(Number(p.daysPerWeek) || 3, 1, 7);
  const trainedDays = new Set(workoutsLast7(user).map(workout => workout.date)).size;
  const missed = Math.max(0, planned - trainedDays);

  if (user.logs.workouts.length) {
    if (missed >= 3) {
      adjustments.days = missed >= 5 ? -2 : -1;
      adjustments.sets = -1;
      alerts.push({
        level: 'warn',
        title: `You missed ${missed} planned workouts this week`,
        body: `You trained ${trainedDays} of ${planned} planned days. Life happens — consistency matters more than perfection, and a 15-minute session still counts.`,
        fix: `Your plan is automatically reduced to ${Math.max(1, planned + adjustments.days)} days this week. Put the session in your calendar and treat it like an appointment.`
      });
    } else if (missed === 2) {
      alerts.push({
        level: 'info',
        title: 'Two sessions slipped this week',
        body: 'You are close to your target, so one strong session can put you back on track.',
        fix: 'Schedule a 20-minute full-body session in the next 48 hours and keep the warm-up short.'
      });
    } else if (trainedDays >= planned) {
      alerts.push({
        level: 'good',
        title: 'You hit your training target',
        body: `${trainedDays} sessions logged against ${planned} planned days. That consistency is what drives progress.`,
        fix: 'Keep the same schedule next week and add a small amount of load or one extra rep where form stays clean.'
      });
    }
  }

  const foodDays = loggedDays(user, 7);
  if (foodDays.length >= 3) {
    const avgCalories = foodDays.reduce((sum, day) => sum + day.calories, 0) / foodDays.length;
    const avgProtein = foodDays.reduce((sum, day) => sum + day.protein, 0) / foodDays.length;
    if (p.goal === 'lose' && avgCalories > base.calories + 250) {
      adjustments.calorie = -100;
      alerts.push({
        level: 'warn',
        title: 'Calories are running above target',
        body: `Your logged average is ${Math.round(avgCalories)} kcal against a ${base.calories} kcal target. A small daily gap adds up over a week.`,
        fix: 'Tighten portion sizes at one meal rather than skipping meals. Your target has been nudged down by 100 kcal this week.'
      });
    } else if (avgCalories < base.calories - 350) {
      adjustments.calorie = 150;
      alerts.push({
        level: 'warn',
        title: 'You are eating well below target',
        body: `Your logged average is ${Math.round(avgCalories)} kcal against a ${base.calories} kcal target. Under-fuelling can hurt recovery and muscle retention.`,
        fix: 'Add a protein-rich snack such as yogurt, eggs or a shake. Your target has been raised by 150 kcal this week.'
      });
    }
    if (avgProtein < base.protein * 0.7) {
      adjustments.protein = 10;
      alerts.push({
        level: 'info',
        title: 'Protein is below your target',
        body: `You are averaging ${Math.round(avgProtein)} g protein against a ${base.protein} g target. Protein protects muscle and keeps you full.`,
        fix: 'Anchor each meal with a palm-sized portion of protein. The daily target has been raised slightly for the next week.'
      });
    }
    if (p.goal === 'lose' && avgCalories <= base.calories + 150 && avgProtein >= base.protein * 0.9) {
      alerts.push({
        level: 'good',
        title: 'Nutrition is matching the plan',
        body: 'Your recent calories and protein are close to target on the days you logged.',
        fix: 'Keep logging the same way and review the weekly average rather than a single day.'
      });
    }
  }

  const sleepAvg = sleepAverage(user);
  if (sleepAvg !== null && sleepAvg < 6.5) {
    adjustments.sets = Math.min(adjustments.sets, -1);
    alerts.push({
      level: 'warn',
      title: 'Sleep is limiting recovery',
      body: `You are averaging ${round(sleepAvg, 1)} hours. Short sleep raises perceived effort and slows recovery.`,
      fix: 'Set a consistent wake time, dim screens an hour before bed, and keep this week’s training volume slightly lower.'
    });
  }

  return { alerts, adjustments };
}

function targets(user) {
  const base = baseTargets(user);
  const insights = getInsights(user);
  const adjustments = insights.adjustments;
  const calories = Math.round(clamp(base.calories + (adjustments.calorie || 0), base.safeMin, 5000) / 10) * 10;
  const protein = Math.round(clamp(base.protein + (adjustments.protein || 0), 60, 260));
  const fat = Math.round(clamp((calories * 0.27) / 9, 35, 130));
  const carbs = Math.max(50, Math.round((calories - protein * 4 - fat * 9) / 4));
  return { ...base, calories, protein, carbs, fat, adjustments };
}

/* ---------------------------------------------------------------------------
   Authentication screen
   --------------------------------------------------------------------------- */
function renderAuth() {
  applyTheme();
  const mode = state.authMode === 'signup' ? 'signup' : 'login';
  const demoAvailable = Boolean(state.db.profiles.demo);
  app.innerHTML = `
    <div class="auth-wrap">
      <div class="auth-shell">
        <section class="auth-hero">
          <div class="brand">${logoMarkup()}<span>Trainer<span class="brand-accent">4U</span></span></div>
          <h1>Train hard.<br>Eat smart.<br><span>Recover better.</span></h1>
          <p>A private, all-in-one coach for fat loss, muscle gain and everything in between. Your profile and logs stay in this browser — no account on a server, no data leaving your device.</p>
          <div class="auth-features">
            <span class="pill accent">Adaptive workouts</span>
            <span class="pill accent">Macro targets</span>
            <span class="pill accent">Recipe mode</span>
            <span class="pill accent">Course correction</span>
          </div>
          <ul class="auth-list">
            <li>1–7 day gym or home plans that adjust when life gets in the way.</li>
            <li>Sixty-plus recipes with diet, cuisine and meal filters.</li>
            <li>Progress charts for weight, measurements and training consistency.</li>
          </ul>
        </section>

        <section class="auth-card">
          <h2>${mode === 'signup' ? 'Create your profile' : 'Welcome back'}</h2>
          <p class="small muted">${mode === 'signup' ? 'One browser, unlimited local profiles. Nothing leaves your device.' : 'Sign in to see your plan, targets and progress.'}</p>

          <div class="segmented auth-switch" role="tablist" aria-label="Sign in or sign up">
            <button type="button" role="tab" aria-selected="${mode === 'login'}" class="${mode === 'login' ? 'active' : ''}" data-action="auth-mode" data-mode="login">Sign in</button>
            <button type="button" role="tab" aria-selected="${mode === 'signup'}" class="${mode === 'signup' ? 'active' : ''}" data-action="auth-mode" data-mode="signup">Sign up</button>
          </div>

          ${state.authError ? `<div class="form-error" role="alert">${esc(state.authError)}</div>` : ''}

          <form data-form="${mode}">
            <div class="form-grid">
              <div class="field span-2">
                <label for="auth-username">Username</label>
                <input id="auth-username" type="text" name="username" maxlength="24" required autocomplete="username" placeholder="e.g. alex">
              </div>
              <div class="field span-2">
                <label for="auth-password">Password</label>
                <input id="auth-password" type="password" name="password" minlength="6" required autocomplete="${mode === 'signup' ? 'new-password' : 'current-password'}" placeholder="At least 6 characters">
              </div>
              ${mode === 'signup' ? `
              <div class="field span-2">
                <label for="auth-confirm">Confirm password</label>
                <input id="auth-confirm" type="password" name="confirm" minlength="6" required autocomplete="new-password" placeholder="Type it again">
              </div>` : ''}
            </div>
            <button class="btn btn-primary w-full" type="submit" style="margin-top:14px">${mode === 'signup' ? 'Create profile' : 'Log in'}</button>
          </form>

          ${mode === 'login' && demoAvailable ? `
            <div class="auth-demo">
              <p>Demo account: <b>demo</b> / <b>demo1234</b> — four weeks of sample data to explore.</p>
              <button class="btn btn-soft btn-sm" type="button" data-action="fill-demo">Use demo</button>
            </div>` : ''}

          <p class="tiny muted" style="margin-top:14px">Passwords are salted and hashed. Data is stored only in this browser. Trainer4U is a wellness tool, not medical care.</p>
        </section>
      </div>
    </div>`;
  window.scrollTo(0, 0);
}

/* ---------------------------------------------------------------------------
   Application shell
   --------------------------------------------------------------------------- */
function renderApp() {
  if (!state.user) { renderAuth(); return; }
  if (!state.user.onboarded || state.editingProfile) { renderOnboarding(); return; }
  applyTheme();
  const u = state.user;
  const insights = getInsights(u);
  const alertCount = insights.alerts.filter(alert => alert.level !== 'good').length;

  const views = {
    dashboard: renderDashboard,
    trainer: renderTrainer,
    nutritionist: renderNutritionist,
    chef: renderChef,
    doctor: renderDoctor,
    progress: renderProgress
  };
  const content = (views[state.tab] || renderDashboard)();
  const displayName = u.profile.name || u.username;

  app.innerHTML = `
    <header class="topbar">
      <div class="brand">${logoMarkup()}<span>Trainer<span class="brand-accent">4U</span></span></div>
      <div class="header-actions">
        <span class="userchip" title="Signed in as ${esc(u.username)}">${esc(displayName)}</span>
        <button class="icon-btn" data-action="toggle-theme" aria-label="Switch between light and dark theme" title="Switch theme">${themeIcon()}</button>
        <button class="icon-btn" data-action="open-settings" aria-label="Settings" title="Settings">${GEAR_ICON}</button>
      </div>
    </header>
    <nav class="tabs" aria-label="Sections">
      ${TABS.map(tab => `
        <button class="tab ${state.tab === tab.id ? 'active' : ''}" data-action="tab" data-tab="${tab.id}" aria-label="${esc(tab.label)}" title="${esc(tab.label)}">
          <span class="tab-ico" aria-hidden="true">${tab.icon}</span><span class="tab-label" aria-hidden="true">${esc(tab.label)}</span>
          ${tab.id === 'dashboard' && alertCount ? `<span class="dot">${alertCount}</span>` : ''}
        </button>`).join('')}
    </nav>
    <main class="main">${content}</main>
    <footer class="foot">Private to this browser · Your profile and logs never leave your device · Not medical advice</footer>`;

  if (state.tab === 'progress') requestAnimationFrame(() => drawCharts());
}

/* ---------------------------------------------------------------------------
   Dashboard
   --------------------------------------------------------------------------- */
function renderAlerts(alerts, limit = 3) {
  if (!alerts.length) {
    return `<div class="alert good">
      <div class="alert-title">You're on track</div>
      <p>No red flags in your recent logs. Keep showing up, keep logging, and let the trend do the work.</p>
    </div>`;
  }
  return alerts.slice(0, limit).map(alert => `
    <div class="alert ${alert.level || 'info'}">
      <div class="alert-title">${esc(alert.title)}</div>
      <p>${esc(alert.body)}</p>
      ${alert.fix ? `<div class="alert-fix"><b>Do this:</b> ${esc(alert.fix)}</div>` : ''}
    </div>`).join('');
}

function renderDashboard() {
  const u = state.user;
  const p = u.profile;
  const plan = buildPlan(u);
  const weekday = (new Date().getDay() + 6) % 7;
  const todayPlan = plan.schedule[weekday];
  const totals = getCaloriesForDate(u, today());
  const t = targets(u);
  const wp = weightProgress(u);
  const streak = loggingStreak(u);
  const weekWorkouts = new Set(workoutsLast7(u).map(workout => workout.date)).size;
  const sleep = sleepAverage(u);
  const hour = new Date().getHours();
  const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
  const goalHeadlines = {
    lose: 'Steady fat loss, without the crash diets.',
    gain: 'Build size with a controlled surplus.',
    build: 'Add muscle. Keep the strength.',
    maintain: 'Stay consistent. Protect what you built.'
  };
  const changeText = wp.change === 0
    ? 'No change since your starting weight.'
    : `${wp.change > 0 ? '+' : ''}${wp.change} kg since your starting weight.`;
  const insights = getInsights(u);
  const alertsToShow = insights.alerts.filter(alert => alert.level !== 'good');
  const shownAlerts = insights.alerts.slice(0, 3);

  return `
    <section class="hero card">
      <div class="hero-top">
        <div>
          <div class="hero-greeting">${greeting}, ${esc(p.name || u.username)}</div>
          <h1>${goalHeadlines[p.goal] || goalHeadlines.maintain}</h1>
          <p class="hero-sub">${p.daysPerWeek} training day${p.daysPerWeek === 1 ? '' : 's'} planned · ${plan.days} scheduled this week · ${DIET_LABELS[p.diet] || p.diet} kitchen · ${plan.mode === 'home' ? 'home' : 'gym'} plan.</p>
        </div>
        <span class="pill accent">${GOAL_LABELS[p.goal] || 'Maintain'}</span>
      </div>
      <div class="hero-progress">
        <div class="progress-label"><span>Goal progress</span><strong>${wp.pct}%</strong></div>
        <div class="progress ${wp.pct >= 100 ? 'good' : ''}"><span style="width:${wp.pct}%"></span></div>
        <div class="tiny muted" style="margin-top:7px">${changeText}${wp.target ? ` Target ${wp.target} kg.` : ' Add a target weight in your profile to track a goal.'}</div>
      </div>
    </section>

    <div class="stats">
      <div class="stat"><div class="stat-value">${wp.current}<small>kg</small></div><div class="stat-label">Current weight</div><div class="stat-sub">${wp.change > 0 ? '+' : ''}${wp.change} kg</div></div>
      <div class="stat"><div class="stat-value">${wp.target || '—'}<small>kg</small></div><div class="stat-label">Target weight</div><div class="stat-sub">${wp.target ? `${wp.toGo} kg to go` : 'Set in profile'}</div></div>
      <div class="stat"><div class="stat-value">${Math.round(totals.calories)}<small>/${t.calories}</small></div><div class="stat-label">Calories today</div><div class="stat-sub">${Math.max(0, t.calories - Math.round(totals.calories))} kcal left</div></div>
      <div class="stat"><div class="stat-value">${Math.round(totals.protein)}<small>/${t.protein} g</small></div><div class="stat-label">Protein today</div><div class="stat-sub">${t.fat} g fat target</div></div>
      <div class="stat"><div class="stat-value">${weekWorkouts}<small>/${p.daysPerWeek}</small></div><div class="stat-label">Workouts this week</div><div class="stat-sub">${plan.days} scheduled after coaching</div></div>
      <div class="stat"><div class="stat-value">${sleep === null ? '—' : round(sleep, 1)}<small>h</small></div><div class="stat-label">Sleep average</div><div class="stat-sub">${streak} day logging streak</div></div>
    </div>

    <div class="grid grid-2">
      <div class="card">
        <div class="card-head">
          <h2>Today's plan</h2>
          <span class="pill">${WEEKDAY_NAMES[weekday]}</span>
        </div>
        <h3 style="margin-bottom:2px">${esc(todayPlan.label)} ${todayPlan.recovery ? '<span class="badge">Active recovery</span>' : ''}</h3>
        <div class="tiny muted">${esc(todayPlan.focus)} · ${todayPlan.exercises.length} exercises</div>
        ${todayPlan.rest ? `
          <p class="small muted" style="margin-top:12px">Rest is part of the plan. Walk, stretch, meal-prep or simply recover — your next session will be there tomorrow.</p>
          <div class="btn-row" style="margin-top:12px">
            <button class="btn btn-sm" data-action="goto-tab" data-tab="trainer">See the week</button>
          </div>` : `
          <div class="today-plan-list">
            ${todayPlan.exercises.slice(0, 5).map(exercise => `
              <div class="today-row">
                <span>${esc(exercise.name)}</span>
                <span class="muted">${exercise.sets} × ${exercise.reps}</span>
              </div>`).join('')}
          </div>
          ${todayPlan.finisher ? `<div class="tiny muted" style="margin-top:9px">Finisher: ${esc(todayPlan.finisher)}</div>` : ''}
          <div class="btn-row" style="margin-top:12px">
            <button class="btn btn-sm btn-primary" data-action="log-workout" data-day="${weekday}">${todayPlan.recovery ? 'Log recovery session' : 'Log workout'}</button>
            <button class="btn btn-sm btn-ghost" data-action="goto-tab" data-tab="trainer">Open trainer</button>
          </div>`}
      </div>

      <div class="card">
        <div class="card-head">
          <h2>Coach's notes</h2>
          <span class="pill ${alertsToShow.length ? 'warn' : 'good'}">${alertsToShow.length ? `${alertsToShow.length} to review` : 'All clear'}</span>
        </div>
        <div class="alert-stack">${renderAlerts(shownAlerts, 3)}</div>
        ${insights.alerts.length > 3 ? `<p class="tiny muted" style="margin-top:9px">+ ${insights.alerts.length - 3} more note${insights.alerts.length - 3 === 1 ? '' : 's'} in the relevant sections. The plan has already adjusted.</p>` : ''}
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2>Quick actions</h2></div>
      <div class="btn-row">
        <button class="btn btn-sm" data-action="goto-tab" data-tab="nutritionist">Log food</button>
        <button class="btn btn-sm" data-action="goto-tab" data-tab="progress">Log weight</button>
        <button class="btn btn-sm" data-action="goto-tab" data-tab="chef">Find a recipe</button>
        <button class="btn btn-sm" data-action="goto-tab" data-tab="doctor">Log water</button>
      </div>
    </div>`;
}
