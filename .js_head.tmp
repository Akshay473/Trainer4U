  gluten: ['gluten', 'wheat', 'bread', 'pasta', 'flour', 'oats', 'pita', 'wrap', 'tortilla', 'noodle', 'bulgur', 'couscous'],
  soy: ['soy', 'tofu', 'edamame', 'miso', 'tempeh'],
  fish: ['fish', 'salmon', 'tuna', 'cod', 'sardine', 'anchovy', 'fish sauce'],
  shellfish: ['shellfish', 'shrimp', 'prawn', 'crab', 'lobster'],
  sesame: ['sesame', 'tahini']
};

/* ---------------------------------------------------------------------------
   Storage, profiles and demo data
   --------------------------------------------------------------------------- */
function blankLogs() {
  return {
    workouts: [],
    food: [],
    weights: [],
    measurements: [],
    sleep: [],
    symptoms: [],
    hydration: {}
  };
}

function loadDB() {
  try {
    const raw = localStorage.getItem(DB_KEY);
    if (!raw) return { profiles: {} };
    const parsed = JSON.parse(raw);
    if (!parsed || typeof parsed !== 'object') return { profiles: {} };
    if (!parsed.profiles || typeof parsed.profiles !== 'object') parsed.profiles = {};
    return parsed;
  } catch (err) {
    return { profiles: {} };
  }
}

function saveDB() {
  try {
    localStorage.setItem(DB_KEY, JSON.stringify(state.db));
  } catch (err) {
    toast('Could not save to this browser. Storage may be full.');
  }
}

function saveUser() {
  if (!state.user) return;
  state.user.key = state.user.key || String(state.user.username || '').toLowerCase();
  state.db.profiles[state.user.key] = state.user;
  saveDB();
}

function createUser(username, salt, hash) {
  const key = String(username).toLowerCase();
  return {
    username,
    key,
    salt,
    hash,
    onboarded: false,
    createdAt: new Date().toISOString(),
    profile: {
      name: '',
      age: null,
      sex: '',
      height: null,
      weight: null,
      targetWeight: null,
      startWeight: null,
      activity: '',
      goal: '',
      diet: '',
      allergies: '',
      injuries: '',
      equipment: ['bodyweight'],
      daysPerWeek: null,
      experience: 'beginner'
    },
    logs: blankLogs(),
    settings: { theme: '', trainerMode: 'gym' }
  };
}

function randomSalt() {
  try {
    const bytes = crypto.getRandomValues(new Uint8Array(16));
    return Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('');
  } catch (err) {
    return `fallback-${Date.now()}-${Math.random().toString(36).slice(2)}`;
  }
}

function fallbackHash(text) {
  let h1 = 0xdeadbeef ^ text.length;
  let h2 = 0x41c6ce57 ^ text.length;
  for (let i = 0; i < text.length; i++) {
    const code = text.charCodeAt(i);
    h1 = Math.imul(h1 ^ code, 2654435761);
    h2 = Math.imul(h2 ^ code, 1597334677);
  }
  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
  return `${(h1 >>> 0).toString(16).padStart(8, '0')}${(h2 >>> 0).toString(16).padStart(8, '0')}`;
}

async function hashPassword(password, salt) {
  const text = `${salt}:${password}`;
  try {
    if (window.crypto && window.crypto.subtle) {
      const bytes = new TextEncoder().encode(text);
      const digest = await window.crypto.subtle.digest('SHA-256', bytes);
      return Array.from(new Uint8Array(digest)).map(byte => byte.toString(16).padStart(2, '0')).join('');
    }
  } catch (err) { /* fall through */ }
  return fallbackHash(text);
}

function sampleFoodEntry(date, meal, name, grams) {
  const food = FOOD_DB.find(item => item.name === name) || { cal: 0, protein: 0, carbs: 0, fat: 0 };
  const factor = Number(grams) / 100;
  return {
    id: uid(),
    date,
    meal,
    name,
    grams: Number(grams),
    calories: round(food.cal * factor, 0),
    protein: round(food.protein * factor, 1),
    carbs: round(food.carbs * factor, 1),
    fat: round(food.fat * factor, 1)
  };
}

