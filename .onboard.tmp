/* ---------- Onboarding / profile editor ---------- */
function renderOnboarding() {
  applyTheme();
  const p = state.user.profile || {};
  const editing = state.editingProfile;
  const isNew = !state.user.onboarded;
  const blank = value => isNew ? '' : (value ?? '');
  const weightValue = isNew ? '' : round(currentWeight(state.user), 1);
  const equipment = isNew ? ['bodyweight'] : (p.equipment || ['bodyweight']);

  app.innerHTML = `
    <div class="onboard-wrap">
      <div class="card onboard">
        <div class="onboard-header">
          <div>
            <div class="brand">${logoMarkup()}<span>Trainer<span class="brand-accent">4U</span></span></div>
            <h1 style="margin-top:14px">${editing ? 'Edit your profile' : `Welcome, ${esc(p.name || state.user.username)}`}</h1>
            <p class="muted small" style="margin-top:5px">${editing ? 'Update your details and targets. Your logs stay intact and every calculation refreshes when you save.' : 'Tell us about yourself so the dashboard, calorie targets and training plan are built from your data — never sample values.'}</p>
          </div>
          ${editing ? '<button class="btn btn-ghost btn-sm" data-action="cancel-edit">Cancel</button>' : ''}
        </div>

        <form data-form="onboarding">
          <div class="form-grid">
            <div class="field span-2">
              <label for="ob-name">Name</label>
              <input id="ob-name" type="text" name="name" maxlength="40" required placeholder="What should we call you?" value="${esc(blank(p.name))}">
            </div>
            <div class="field">
              <label for="ob-age">Age</label>
              <input id="ob-age" type="number" name="age" min="14" max="90" required placeholder="e.g. 29" value="${blank(p.age)}">
            </div>
            <div class="field">
              <label for="ob-sex">Sex (used for the BMR formula)</label>
              <select id="ob-sex" name="sex" required>
                <option value="" ${selected('', p.sex)}>Select sex</option>
                <option value="male" ${selected('male', p.sex)}>Male</option>
                <option value="female" ${selected('female', p.sex)}>Female</option>
                <option value="other" ${selected('other', p.sex)}>Other / prefer not to say</option>
              </select>
            </div>
            <div class="field">
              <label for="ob-height">Height (cm)</label>
              <input id="ob-height" type="number" name="height" min="120" max="230" step="0.5" required placeholder="e.g. 175" value="${blank(p.height)}">
            </div>
            <div class="field">
              <label for="ob-weight">Current weight (kg)</label>
              <input id="ob-weight" type="number" name="weight" min="30" max="300" step="0.1" required placeholder="e.g. 80" value="${weightValue}">
            </div>
            <div class="field">
              <label for="ob-target">Target weight (kg, optional)</label>
              <input id="ob-target" type="number" name="targetWeight" min="30" max="300" step="0.1" placeholder="e.g. 75" value="${blank(p.targetWeight)}">
            </div>
            <div class="field">
              <label for="ob-days">Available workout days per week</label>
              <select id="ob-days" name="daysPerWeek" required>
                <option value="" ${selected('', p.daysPerWeek)}>Select 1–7 days</option>
                ${[1, 2, 3, 4, 5, 6, 7].map(n => `<option value="${n}" ${selected(n, p.daysPerWeek)}>${n} day${n === 1 ? '' : 's'}</option>`).join('')}
              </select>
            </div>
            <div class="field">
              <label for="ob-activity">Activity level (outside workouts)</label>
              <select id="ob-activity" name="activity" required>
                <option value="" ${selected('', p.activity)}>Select activity level</option>
                ${Object.entries(ACTIVITY_LABELS).map(([value, label]) => `<option value="${value}" ${selected(value, p.activity)}>${label}</option>`).join('')}
              </select>
            </div>
            <div class="field">
              <label for="ob-goal">Main goal</label>
              <select id="ob-goal" name="goal" required>
                <option value="" ${selected('', p.goal)}>Select your goal</option>
                ${Object.entries(GOAL_LABELS).map(([value, label]) => `<option value="${value}" ${selected(value, p.goal)}>${label}</option>`).join('')}
              </select>
            </div>
            <div class="field">
              <label for="ob-diet">Diet preference</label>
              <select id="ob-diet" name="diet" required>
                <option value="" ${selected('', p.diet)}>Select diet preference</option>
                ${Object.entries(DIET_LABELS).map(([value, label]) => `<option value="${value}" ${selected(value, p.diet)}>${label}</option>`).join('')}
              </select>
            </div>
            <div class="field">
              <label for="ob-experience">Training experience</label>
              <select id="ob-experience" name="experience">
                <option value="beginner" ${selected('beginner', p.experience || 'beginner')}>Beginner — new or returning</option>
                <option value="intermediate" ${selected('intermediate', p.experience)}>Intermediate — consistent for 6+ months</option>
              </select>
            </div>
            <div class="field">
              <label for="ob-allergies">Allergies / intolerances</label>
              <input id="ob-allergies" type="text" name="allergies" value="${esc(p.allergies || '')}" placeholder="e.g. peanuts, dairy, gluten">
            </div>
            <div class="field span-2">
              <label for="ob-injuries">Injuries or conditions (optional)</label>
              <textarea id="ob-injuries" name="injuries" placeholder="e.g. knee pain when squatting, lower-back tightness, asthma">${esc(p.injuries || '')}</textarea>
            </div>
            <div class="field span-2">
              <label>Equipment available</label>
              <div class="check-grid">
                ${EQUIPMENT.map(([value, label]) => `
                  <label class="check"><input type="checkbox" name="equipment" value="${value}" ${checked(value, equipment)}> ${label}</label>
                `).join('')}
              </div>
              <span class="form-note">Bodyweight is always included. Home plans use bodyweight plus any dumbbells, bands or kettlebells you have.</span>
            </div>
          </div>
          <button class="btn btn-primary w-full" type="submit" style="margin-top:18px">${editing ? 'Save profile and recalculate' : 'Build my dashboard and plan'}</button>
          <p class="form-note" style="text-align:center;margin-top:10px">All calculations are estimates for healthy adults. This app does not replace medical or dietetic advice.</p>
        </form>
      </div>
    </div>`;
  window.scrollTo(0, 0);
}
