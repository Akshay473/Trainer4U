/* ---------- Trainer ---------- */
function renderTrainer() {
  const u = state.user;
  const p = u.profile;
  const plan = buildPlan(u);
  const mode = plan.mode;
  const todayWeekday = (new Date().getDay() + 6) % 7;
  const history = [...u.logs.workouts].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6);
  const homeKit = (p.equipment || []).filter(item => ['dumbbells', 'bands', 'kettlebell'].includes(item));
  const kitLabels = homeKit.map(item => (EQUIPMENT.find(([value]) => value === item) || [item, item])[1]);
  const modeNote = mode === 'gym'
    ? 'Gym plan: machines, cables, barbells and dumbbells, chosen for your goal and experience. The plan assumes a standard gym floor.'
    : `Home plan: bodyweight movements${kitLabels.length ? ` plus ${kitLabels.join(', ').toLowerCase()}` : ' only — add dumbbells or bands in your profile for more variety'}.`;
  const injuryCount = p.injuries ? EXERCISES.filter(ex => injuryAvoids(ex, p.injuries)).length : 0;

  return `
    <div class="section-head">
      <div>
        <h1>Trainer</h1>
        <p class="sub">A ${(GOAL_LABELS[p.goal] || 'maintain').toLowerCase()} plan built around ${esc(p.experience || 'beginner')} experience and ${p.daysPerWeek || plan.days} available day${p.daysPerWeek === 1 ? '' : 's'}. Every day includes sets, reps, rest and a form cue.</p>
      </div>
      <span class="pill accent">${plan.days} day${plan.days === 1 ? '' : 's'} / week</span>
    </div>

    <div class="card trainer-switch">
      <div class="segmented" role="tablist" aria-label="Workout location">
        <button type="button" class="${mode === 'gym' ? 'active' : ''}" data-action="trainer-mode" data-mode="gym" role="tab" aria-selected="${mode === 'gym'}">Gym Workouts</button>
        <button type="button" class="${mode === 'home' ? 'active' : ''}" data-action="trainer-mode" data-mode="home" role="tab" aria-selected="${mode === 'home'}">Home Workouts</button>
      </div>
      <span class="pill">${mode === 'gym' ? 'Machines & weights' : 'Bodyweight + optional kit'}</span>
      <p class="mode-note">${esc(modeNote)}</p>
    </div>

    ${plan.adjustments.days ? `
      <div class="alert info">
        <div class="alert-title">Auto-coaching is active</div>
        <p>Because you missed several sessions recently, this week's plan was reduced from ${p.daysPerWeek} to ${plan.days} day${plan.days === 1 ? '' : 's'}. It will return to your normal schedule when your consistency improves.</p>
      </div>` : ''}

    ${p.injuries ? `
      <div class="alert info">
        <div class="alert-title">Injury-aware selection</div>
        <p>You noted: "${esc(p.injuries)}". ${injuryCount ? `${injuryCount} movement${injuryCount === 1 ? '' : 's'} commonly linked to that area were filtered out of this plan.` : 'Your plan already avoids the highest-risk movements for that area.'} This is not a diagnosis — get clearance from a physiotherapist or doctor before loading an injured area.</p>
      </div>` : ''}

    <div class="grid grid-2">
      ${plan.schedule.map(day => {
        const isToday = day.weekday === todayWeekday;
        if (day.rest) {
          return `
          <div class="card day-card rest-card">
            <div class="day-top">
              <div>
                <div class="day-weekday">${day.weekdayName}${isToday ? ' · today' : ''}</div>
                <div class="day-name">Rest &amp; recover</div>
              </div>
              <span class="badge">Recovery</span>
            </div>
            <p class="recovery-tip">Walk, stretch, meal-prep or simply rest. Aim for 7–9 hours of sleep tonight.</p>
          </div>`;
        }
        return `
        <div class="card day-card">
          <div class="day-top">
            <div>
              <div class="day-weekday">${day.weekdayName}${isToday ? ' · today' : ''}</div>
              <div class="day-name">${esc(day.label)}</div>
            </div>
            ${day.recovery ? '<span class="badge">Active recovery</span>' : isToday ? '<span class="badge good">Today</span>' : '<span class="badge">Training</span>'}
          </div>
          <div class="tiny muted">${esc(day.focus)} · ${day.exercises.length} movements</div>
          <div class="exercise-list">
            ${day.exercises.map(ex => {
              const hint = day.recovery ? '' : overloadHint(u, ex.name, ex.reps);
              return `
              <div class="exercise">
                <div class="exercise-head">
                  <span class="exercise-name">${esc(ex.name)}</span>
                  <span class="badge">${ex.sets} × ${ex.reps}</span>
                </div>
                ${ex.rest ? `<div class="exercise-meta">Rest ${ex.rest}s between sets</div>` : '<div class="exercise-meta">Continuous, easy pace</div>'}
                <details class="exercise-cues"><summary>Instructions</summary>${esc(ex.cues)}</details>
                ${hint ? `<div class="overload">${esc(hint)}</div>` : ''}
              </div>`;
            }).join('')}
          </div>
          ${day.finisher ? `<div class="tiny muted">Finisher: ${esc(day.finisher)}</div>` : ''}
          <button class="btn btn-primary btn-sm" data-action="log-workout" data-day="${day.weekday}">${day.recovery ? 'Log recovery session' : 'Log workout'}</button>
        </div>`;
      }).join('')}
    </div>

    <div class="card">
      <div class="card-head"><h2>Progressive overload</h2></div>
      <p class="small muted">Progress comes from doing a little more over time. The hints above use your last logged session: when you hit the top of the rep range with good form, add 2.5 kg (or choose a harder variation). If form breaks, stay at the same weight and build reps first.</p>
      <div class="grid grid-3" style="margin-top:12px">
        <div class="stat"><div class="stat-value">${p.experience === 'intermediate' ? '2.5–5 kg' : '2.5 kg'}</div><div class="stat-label">Typical jump</div></div>
        <div class="stat"><div class="stat-value">${p.goal === 'lose' ? '45s' : p.goal === 'maintain' ? '60s' : '90s'}</div><div class="stat-label">Rest target</div></div>
        <div class="stat"><div class="stat-value">${repRangeFor(p.goal)}</div><div class="stat-label">Rep range</div></div>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2>Recent workouts</h2><span class="pill">${u.logs.workouts.length} total</span></div>
      ${history.length ? history.map(w => `
        <div class="history-row">
          <div>
            <div style="font-weight:700">${esc(w.label)} <span class="tiny muted">· ${prettyDate(w.date)}</span></div>
            <div class="tiny muted">${w.duration} min · ${w.exercises?.length || 0} exercises${w.notes ? ` · ${esc(w.notes)}` : ''}</div>
          </div>
          <button class="btn btn-xs btn-danger" data-action="delete-workout" data-id="${esc(w.id)}">Delete</button>
        </div>`).join('') : '<div class="empty">No workouts logged yet. Pick a day above and log your first session.</div>'}
    </div>`;
}
